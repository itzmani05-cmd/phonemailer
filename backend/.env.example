# Copy to backend/.env for local development.
PORT=3000
INBOUND_SECRET=change-me

# PostgreSQL (docker compose sets this for the container itself)
DATABASE_URL=postgresql://phonemail:phonemail@localhost:5432/phonemail

# ---- Account (sender address = <ACCOUNT_PHONE>@<MAIL_DOMAIN>) ----
ACCOUNT_PHONE=9876543210
ACCOUNT_NAME=
MAIL_DOMAIN=phonemail.com

# ---- Outbound SMTP (POST /email/send) ----
# Examples:
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=465 SMTP_SECURE=true  (use an App Password)
#   SES:      SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587 SMTP_SECURE=false
#   Mailpit:  SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURE=false  (no auth, dev inbox at :8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to false only for local relays with self-signed certificates.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Leave empty to send as the account address above.
MAIL_FROM=

# Clients must send this as the x-api-key header. Required when NODE_ENV=production.
EMAIL_API_KEY=
