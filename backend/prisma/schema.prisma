generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String    @unique
  name            String?
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  mobileAppAt     DateTime?
  avatar          Bytes?
  avatarType      String?
  avatarUpdatedAt DateTime?
  messages        Message[]
  labels          Label[]
  aliases         Alias[]
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum RecipientType {
  TO
  CC
  BCC
}

enum MailDirection {
  in
  out
}

enum MailFolder {
  inbox
  sent
  drafts
  archive
  spam
  trash
}

enum MailCategory {
  primary
  social
  promotions
}

model Message {
  id           String         @id @default(uuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  direction    MailDirection
  folder       MailFolder     @default(inbox)
  category     MailCategory   @default(primary)
  labels       String[]       @default([])
  read         Boolean        @default(false)
  starred      Boolean        @default(false)
  snoozedUntil DateTime?
  fromHeader   String
  envelopeFrom String?
  subject      String
  text         String?
  html         String?
  messageId    String?
  inReplyTo    String?
  date         DateTime       @default(now())
  size         Int            @default(0)
  status       MessageStatus?
  smtpResponse String?
  error        String?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?
  recipients   Recipient[]
  attachments  Attachment[]

  @@index([ownerId, createdAt])
  @@index([ownerId, messageId])
}

model Recipient {
  id        String        @id @default(uuid())
  messageId String
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  email     String
  type      RecipientType

  @@index([messageId])
  @@index([email])
}

model Attachment {
  id          String  @id @default(uuid())
  messageId   String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  index       Int     @default(0)
  filename    String?
  contentType String
  size        Int
  content     Bytes?

  @@index([messageId])
}

model Label {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  color   String

  @@unique([ownerId, name])
}

model Alias {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String   @unique
  createdAt DateTime @default(now())

  @@index([ownerId])
}
