POSTGRES_USER=phonemail
POSTGRES_PASSWORD=phonemail
POSTGRES_DB=phonemail

# Shared secret the mail-server sends to backend /mail/inbound
INBOUND_SECRET=change-me

# Host port for SMTP (use 25 in production)
SMTP_HOST_PORT=2525

# Outbound SMTP relay for POST /email/send (see backend/.env.example for provider examples)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM='"Phone Mailer" <no-reply@example.com>'
# Required: clients send it as the x-api-key header
EMAIL_API_KEY=change-me-too
